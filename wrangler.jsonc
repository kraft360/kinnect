{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kinnect",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-12",
	// The Vite plugin builds the web app and points assets at its output.
	// Unknown paths outside /api get index.html, so client-side routes work.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ORG", "class_name": "OrgDO" },
			{ "name": "DIRECTORY", "class_name": "DirectoryDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrgDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["DirectoryDO"] }
	],
	"vars": {
		// Set by `npm run vapid`. Public key only; the private key is a secret.
		"VAPID_PUBLIC_KEY": "BGK8yALBzJLeKkz4uTdi89SGUGdSi3VHiRFmMX9gWbCR_6bMLSv_MXKLs0umziyPm1HitofKeFRAyfgT4rVMX3Y"
	},
	// Secrets (not in this file): VAPID_PRIVATE_KEY, OPERATOR_SECRET. Locally they go in .dev.vars.
	// APP_URL (e.g. https://kinnect.<you>.workers.dev) isn't secret but differs per deployment, so it
	// lives there too: push services use it to contact the sender, and operator links point at it.
	"secrets": { "required": ["VAPID_PRIVATE_KEY", "OPERATOR_SECRET", "APP_URL"] },
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true }
}
